# Единый .env для docker-compose (корень репозитория) и для backend
# (pydantic-settings читает "../.env" относительно backend/ при запуске `uv run`).
# Скопируйте в .env и подставьте свои значения; .env в git не попадает.

ENV=dev

# --- backend Settings (env_nested_delimiter="__") ---
# Для запуска backend на хосте (uv run) — Postgres/Redis опубликованы на localhost.
# Внутри docker-compose сервисы api/worker сами переопределяют DB__DSN/REDIS__DSN
# на имена сервисов (postgres, redis) — см. docker-compose.yml.
DB__DSN=postgresql+asyncpg://syncplaylists:syncplaylists@localhost:5432/syncplaylists
DB__POOL_SIZE=10
DB__ECHO=false

REDIS__DSN=redis://localhost:6379/0

# --- безопасность (этап 4a) ---
# Ключ AES-256-GCM для токенов площадок: base64 от 32 случайных байт. Сгенерировать:
#   uv run python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Смена ключа сделает уже сохранённые токены нечитаемыми (ротации пока нет).
SECURITY__TOKEN_ENCRYPTION_KEY=
# В dev по http — false (иначе браузер не сохранит cookie). В проде — true:
# cookie получает флаг Secure и имя с префиксом __Host-.
SECURITY__COOKIE_SECURE=false
# Время жизни сессии, минуты (по умолчанию 7 дней).
SECURITY__SESSION_TTL_MINUTES=10080

# Origin'ы фронтенда, которым разрешены запросы с cookie (JSON-список, без "*").
CORS__ALLOWED_ORIGINS=["http://localhost:5173"]

# --- OAuth подключения площадок ---
# Публичный адрес API (на него площадка возвращает пользователя) и страница фронта после.
OAUTH__CALLBACK_BASE_URL=http://localhost:8000
OAUTH__FRONTEND_REDIRECT_URL=http://localhost:5173/accounts
# Площадки, для которых включён фейковый OAuth-провайдер (dev), JSON-список: ["spotify"].
OAUTH__FAKE_PLATFORMS=[]

# --- площадки (этап 4b) ---
# Площадки, которые обслуживает in-memory фейк вместо настоящего адаптера (dev), JSON-список.
# Настоящий адаптер пока только у Яндекса; остальные без фейка — «не поддерживается».
PLATFORMS__FAKE=["vk", "spotify", "soundcloud", "ytmusic"]
# Token bucket на (площадка, аккаунт): всплеск, устойчивая частота, сколько ждать токен.
PLATFORMS__YANDEX__RATE_LIMIT__CAPACITY=5
PLATFORMS__YANDEX__RATE_LIMIT__REFILL_PER_SECOND=3
PLATFORMS__YANDEX__RATE_LIMIT__MAX_WAIT_SECONDS=10
PLATFORMS__YANDEX__REQUEST_TIMEOUT_SECONDS=15
PLATFORMS__YANDEX__BATCH_SIZE=100
PLATFORMS__LINK_EXPANDER_TIMEOUT_SECONDS=5

# Только для live-тестов (uv run pytest -m live): ваш токен Яндекс Музыки.
# Как получить безопасно — docs/YANDEX_TOKEN.md. Никогда не коммитьте .env.
# YANDEX_LIVE_TOKEN=

# --- docker-compose: postgres ---
# Должны соответствовать DB__DSN выше.
POSTGRES_USER=syncplaylists
POSTGRES_PASSWORD=syncplaylists
POSTGRES_DB=syncplaylists

# --- docker-compose: s3 (SeaweedFS) ---
# Dev-режим SeaweedFS S3-gateway запускается без аутентификации (без -s3.config),
# поэтому отдельных переменных не требует. S3-клиент в коде появится в этапе backups.
