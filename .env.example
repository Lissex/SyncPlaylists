# Единый .env для docker-compose (корень репозитория) и для backend
# (pydantic-settings читает "../.env" относительно backend/ при запуске `uv run`).
# Скопируйте в .env и подставьте свои значения; .env в git не попадает.

ENV=dev

# --- backend Settings (env_nested_delimiter="__") ---
# Для запуска backend на хосте (uv run) — Postgres/Redis опубликованы на localhost.
# Внутри docker-compose сервисы api/worker сами переопределяют DB__DSN/REDIS__DSN
# на имена сервисов (postgres, redis) — см. docker-compose.yml.
DB__DSN=postgresql+asyncpg://syncplaylists:syncplaylists@localhost:5432/syncplaylists
DB__POOL_SIZE=10
DB__ECHO=false

REDIS__DSN=redis://localhost:6379/0

# --- docker-compose: postgres ---
# Должны соответствовать DB__DSN выше.
POSTGRES_USER=syncplaylists
POSTGRES_PASSWORD=syncplaylists
POSTGRES_DB=syncplaylists

# --- docker-compose: s3 (SeaweedFS) ---
# Dev-режим SeaweedFS S3-gateway запускается без аутентификации (без -s3.config),
# поэтому отдельных переменных не требует. S3-клиент в коде появится в этапе backups.
