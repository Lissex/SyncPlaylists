# Скопируйте в .env (не в git). Читается при сборке (wxt build / wxt).
# Адрес API SyncPlaylists: обязательный host permission и WebSocket /extension/ws.
WXT_API_BASE=http://localhost:8000
# Страница сайта «Подключения», где вводят код привязки.
WXT_PAIR_URL=http://localhost:5173/connections
# id для Firefox (browser_specific_settings.gecko.id).
WXT_GECKO_ID=syncplaylists@syncplaylists.local
